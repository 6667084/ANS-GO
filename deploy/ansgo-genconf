staged = []
try:
    if mode in ("sing-box", "caddy", "all"):
        check_port_conflicts()
    if mode in ("sing-box", "all"):
        gen_singbox()
    if mode in ("caddy", "all"):
        gen_caddy()
    if mode == "validate":
        sys.exit(do_validate())
    # all 模式两份配置都通过校验后再替换，校验失败不影响任何正式文件。
    for temporary, path in staged:
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
finally:
    for temporary, _ in staged:
        if os.path.exists(temporary):
            os.unlink(temporary)

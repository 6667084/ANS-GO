#!/bin/bash
# =============================================================================
# ansgo-admin —— ANS-GO 离线管理脚本（bash，不依赖面板二进制）
#
# 面板全挂也能用 SSH 管理一切。配置源头：
#   /etc/ansgo/panel.json   端口+面板设置+域名 (JSON)
#   /etc/ansgo/secrets.env      SS_KEY/ANYTLS_*/SOCKS_*/NAIVE_* (原始 KEY=value，仅去掉成对外层引号)
#
# 用法见末尾 usage() 或 README。
# =============================================================================
set -uo pipefail
ROOT="${ANSGO_ROOT:-}"
CONF="${ANSGO_CONF:-$ROOT/etc/ansgo/panel.json}"
SECRETS="$ROOT/etc/ansgo/secrets.env"
CERTDIR="$ROOT/etc/ssl/ansgo"
BACKUP_ROOT="$ROOT/etc/ansgo-backup"
LIB="${ANSGO_LIB:-/usr/local/bin/ansgo-limits}"
[ -f "$LIB" ] || LIB="$(dirname "${BASH_SOURCE[0]}")/ansgo-limits"
source "$LIB" || exit 1
BVPANEL="$ROOT/usr/local/bin/ansgo-panel"
DOMAIN_DEF="example.com"

# ---------- 颜色 ----------
if [ -t 1 ]; then C_R='\033[31m'; C_G='\033[32m'; C_Y='\033[33m'; C_B='\033[36m'; C_0='\033[0m'; else C_R='';C_G='';C_Y='';C_B='';C_0=''; fi
ok(){ printf '%s[OK]%s %s\n' "$C_G" "$C_0" "$*"; }
warn(){ printf '%s[!]%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
err(){ printf '%s[X]%s %s\n' "$C_R" "$C_0" "$*" >&2; }
hr(){ printf '%s---- %s ----%s\n' "$C_B" "$*" "$C_0"; }

# ---------- 配置读写 ----------
_conf(){ python3 -c "import json; d=json.load(open('$CONF')); print(d.get('$1',''))" 2>/dev/null; }
_setconf(){ # KEY VALUE  -> 写回 config.json (保留 2 空格缩进)
  python3 - "$1" "$2" <<'PY'
import json,os,sys
p=os.environ.get("ANSGO_ROOT","")+"/etc/ansgo/panel.json"
k,v=sys.argv[1],sys.argv[2]
d=json.load(open(p))
# 数值尽量转 int
try: v=int(v)
except: pass
d[k]=v
import os,tempfile
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(p),prefix=".ansgo-conf-")
with os.fdopen(fd,"w") as f: json.dump(d,f,indent=2,ensure_ascii=False); f.write("\n")
os.chmod(tmp,0o600); os.replace(tmp,p)
PY
}
DOMAIN(){ local d; d="$(_conf domain)"; echo "${d:-$DOMAIN_DEF}"; }
_secret(){ python3 - "$SECRETS" "$1" <<'PYSEC'
import sys
p,key=sys.argv[1:]
try:
    for line in open(p):
        if '=' not in line or line.lstrip().startswith('#'): continue
        k, v = line.rstrip('\r\n').split('=', 1)
        if k.strip() == key:
            value = v[1:-1] if len(v)>=2 and v[0]==v[-1] and v[0] in ("'", '"') else v
    print(value if 'value' in locals() else '')
except OSError: pass
PYSEC
}

# ---------- 服务映射 ----------
# ss / anytls 都由 sing-box 承载；naive 由 caddy 承载；panel 独立
svc_of(){ case "$1" in ss|anytls|socks) echo sing-box;; naive|caddy) echo caddy;; panel) echo ansgo-panel;; *) echo "$1";; esac; }

restart_svc(){ local s="$1"; systemctl restart "$s" && systemctl is-active --quiet "$s" && ok "已 restart $s" || { err "restart $s 失败"; return 1; }; }
stop_svc(){ local s="$1"; systemctl stop "$s" 2>/dev/null && ok "已 stop $s" || err "stop $s 失败"; }

# ---------- 备份 ----------
_restart_after_restore_failure(){
  local list="$1" svc rc=0
  for svc in caddy sing-box ansgo-panel; do
    printf '%s\n' "$list" | grep -qx "$svc" || continue
    if systemctl restart "$svc" && systemctl is-active --quiet "$svc"; then
      ok "已恢复原运行服务 $svc"
    else
      err "恢复失败后无法重启 $svc"
      rc=1
    fi
  done
  return "$rc"
}

do_backup(){
  local archive
  archive=$(ansgo_backup manual /etc/sing-box /etc/caddy /etc/ssl/ansgo \
    /etc/ansgo /root/.acme.sh /etc/systemd/system/ansgo-panel.service \
    /etc/systemd/system/sing-box.service /etc/systemd/system/caddy.service \
    /etc/systemd/system/ansgo-panel.service.d /etc/systemd/system/caddy.service.d \
    /etc/systemd/system/sing-box.service.d) || return 1
  ok "备份 -> $archive"
  cmd_prune --yes || return 1
  return 0
}

cmd_prune(){
  if [ "${1:-}" != --yes ]; then
    local answer
    read -r -p "按保留策略清理备份、过期临时文件及日志？[y/N] " answer
    case "$answer" in y|Y) ;; *) return 0;; esac
  fi
  local freed
  freed=$(python3 - "$ROOT" "$CONF" <<'PYPRUNE'
import glob, json, os, re, shutil, sys, time
root, conf = sys.argv[1:]
try: keep = max(1, min(30, int(json.load(open(conf)).get('backup_keep', 5))))
except (OSError, ValueError, TypeError): keep = 5
now = time.time()
def size(path):
    if os.path.islink(path): return os.lstat(path).st_size
    if os.path.isfile(path): return os.path.getsize(path)
    total = 0
    for base, dirs, files in os.walk(path, followlinks=False):
        for name in files:
            try: total += os.lstat(os.path.join(base, name)).st_size
            except OSError: pass
        # 目录自身通常只占 4K；不累加以免小盘备份被数量放大。
    return total
freed = 0
def remove(path):
    global freed
    n = size(path)
    if os.path.isdir(path) and not os.path.islink(path): shutil.rmtree(path)
    else: os.unlink(path)
    freed += n
    print('已清理: '+path, file=sys.stderr)
paths = []
for pattern in ('/etc/ansgo-backup/*', '/etc/ansgo-backup-*',
                '/etc/ansgo-docker/ansgo-etc-vol-backup-*.tgz'):
    for path in glob.glob(root+pattern):
        # 只删除项目命名的备份；忽略进行中的隐藏暂存目录及用户文件。
        m = re.fullmatch(r'(.+)-(\d{8}-\d{6})(?:-\d+)?(?:\.tar\.gz|\.tgz)?', os.path.basename(path))
        if m and not os.path.islink(path): paths.append((path, m[1], m[2]))
groups = {}
for path, category, stamp in paths:
    groups.setdefault(category, []).append((path, stamp))
remaining = []
for category, items in groups.items():
    limit = min(keep, 2) if category in ('upgrade', 'ansgo-backup-upgrade', 'ansgo-etc-vol-backup') else keep
    items.sort(key=lambda x: (x[1], os.stat(x[0]).st_mtime_ns), reverse=True)
    for path, stamp in items[limit:]: remove(path)
    remaining.extend(items[:limit])
remaining.sort(key=lambda x: (x[1], os.stat(x[0]).st_mtime_ns))
total = sum(size(p) for p, _ in remaining)
for path, _ in remaining:
    if total <= 200*1024*1024: break
    n = size(path); remove(path); total -= n
for pattern in ('/etc/ansgo/probe-tmp/*', '/tmp/sing-box-*', '/tmp/caddy-naive-build',
                '/tmp/acme.sh-*', '/root/acme.sh-*', '/tmp/ansgo-ss-probe-*',
                '/tmp/sb.tgz', '/tmp/acme.tar.gz', '/tmp/go.tgz'):
    for path in glob.glob(root+pattern):
        if not os.path.islink(path) and now-os.stat(path).st_mtime > 600:
            remove(path)
# 会话/锁定表过期项属于本次清理的一部分；SQLite 不存在时跳过。
db = root+'/etc/ansgo/sessions.db'
if os.path.isfile(db):
    import sqlite3
    try:
        with sqlite3.connect(db, timeout=2) as con:
            before=os.path.getsize(db)
            con.execute('DELETE FROM sessions WHERE expires < ?', (int(now),))
            try: con.execute("DELETE FROM lockout WHERE locked_until < ?", (int(now),))
            except sqlite3.OperationalError: pass
            con.commit()
            con.execute('PRAGMA wal_checkpoint(PASSIVE)')
        freed += max(0, before-os.path.getsize(db))
    except sqlite3.Error as exc:
        print('SQLite 清理跳过: '+str(exc), file=sys.stderr)
print(freed)
PYPRUNE
) || return 1
  # 测试根目录下不触碰宿主 journald。
  if [ -z "$ROOT" ] && command -v journalctl >/dev/null; then
    journalctl --vacuum-size=50M >&2 || return 1
  fi
  printf 'FREED_BYTES=%s\n' "$freed"
}

# ---------- 密钥更新 ----------
_setsecret(){
  python3 - "$SECRETS" "$1" "$2" <<'PYSECRET'
import os, re, sys, tempfile
p, k, v = sys.argv[1:]
if not re.fullmatch(r'[A-Z][A-Z0-9_]*', k) or any(c in v for c in "\n\r\0"):
    sys.exit('凭证不能包含换行或 NUL')
lines = open(p).read().splitlines() if os.path.exists(p) else []
lines = [line for line in lines if not line.startswith(k+'=')]+[k+'='+v]
fd, tmp = tempfile.mkstemp(prefix='.ansgo-secret-', dir=os.path.dirname(p))
try:
    with os.fdopen(fd, 'w') as f: f.write('\n'.join(lines)+'\n')
    os.chmod(tmp, 0o600); os.replace(tmp,p)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PYSECRET
}
gen_ss_key(){ openssl rand -base64 16; }
gen_anytls_pass(){ openssl rand -hex 16; }
gen_naive_user(){ openssl rand -hex 6; }
gen_naive_pass(){ openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 20; }
gen_socks_user(){ openssl rand -hex 6; }
gen_socks_pass(){ openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | head -c 20; }
gen_panel_pass(){ openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 22; }

# ---------- URI 生成 ----------
print_uris(){
  local domain; domain="$(DOMAIN)"
  local ss_port anytls_port socks_port naive_port SS_METHOD SS_KEY ANYTLS_PASS SOCKS_USER SOCKS_PASS NAIVE_USER NAIVE_PASS
  ss_port="$(_conf ss_port)"; anytls_port="$(_conf anytls_port)"; socks_port="$(_conf socks_port)"; naive_port="$(_conf naive_port)"
  SS_METHOD="$(_secret SS_METHOD)"; [ -n "$SS_METHOD" ] || SS_METHOD=2022-blake3-aes-128-gcm
  SS_KEY="$(_secret SS_KEY)"
  ANYTLS_PASS="$(_secret ANYTLS_PASS)"; SOCKS_USER="$(_secret SOCKS_USER)"
  SOCKS_PASS="$(_secret SOCKS_PASS)"; NAIVE_USER="$(_secret NAIVE_USER)"; NAIVE_PASS="$(_secret NAIVE_PASS)"
  # v1.5.26: 落地服务凭证（LANDING_<id>_PASS），由 python 段读取 secrets.env 全量后匹配
  python3 - "$domain" "${ss_port:-23456}" "${anytls_port:-8443}" "${socks_port:-10808}" "${naive_port:-44333}" \
          "$SS_METHOD" "${SS_KEY:-}" "${ANYTLS_PASS:-}" "${SOCKS_USER:-}" "${SOCKS_PASS:-}" "${NAIVE_USER:-}" "${NAIVE_PASS:-}" \
          "$CONF" "$SECRETS" <<'PY'
import sys,base64,urllib.parse,json
domain,ssp,atp,sop,nvp,method,ssk,atp_pass,su,sp,nu,np,CONF,SECRETS=sys.argv[1:15]
def b64u(s): return base64.urlsafe_b64encode(s.encode()).decode().rstrip("=")
print("=== 客户端连接 URI ===")
idx=1
if ssk:
    ui=b64u(f"{method}:{ssk}")
    print(f"[{idx}] Shadowsocks : ss://{ui}@{domain}:{ssp}#ANS-GO-SS"); idx+=1
if atp_pass:
    print(f"[{idx}] AnyTLS      : anytls://{urllib.parse.quote(atp_pass,safe='')}@{domain}:{atp}/?sni={domain}#ANS-GO-AnyTLS"); idx+=1
if su and sp:
    print(f"[{idx}] SOCKS5      : socks5://{urllib.parse.quote(su,safe='')}:{urllib.parse.quote(sp,safe='')}@{domain}:{sop}#ANS-GO-SOCKS5"); idx+=1
if nu and np:
    print(f"[{idx}] NaiveProxy  : naive+https://{urllib.parse.quote(nu,safe='')}:{urllib.parse.quote(np,safe='')}@{domain}:{nvp}#ANS-GO-Naive"); idx+=1
# v1.5.26: 落地服务列表（从 panel.json landings + secrets.env LANDING_<id>_PASS 读出）
try:
    cfg=json.load(open(CONF))
    secs={}
    for line in open(SECRETS):
        line=line.rstrip('\r\n')
        if line and not line.startswith("#") and "=" in line:
            k,_,v=line.partition("=")
            secs[k.strip()]=v[1:-1] if len(v)>=2 and v[0]==v[-1] and v[0] in ("'", '"') else v
    for L in cfg.get("landings",[]):
        if str(L.get("enabled","false")).lower() not in ("true","1"): continue
        lid=str(L.get("id",""))
        lp=secs.get(f"LANDING_{lid}_PASS","")
        if not lp: continue
        port=L.get("port",0)
        name=L.get("name",lid)
        via="direct"
        if str(L.get("remote_enabled","false")).lower() in ("true","1"):
            rtype=L.get("remote_type","ss")
            via=f"{rtype}-landing"
        print(f"[{idx}] 落地-{name:<8} : anytls://{urllib.parse.quote(lp,safe='')}@{domain}:{port}/?sni={domain}#ANS-GO-Landing-{name}  ({via})"); idx+=1
except Exception as e:
    print(f"  (落地服务读取失败: {e})", file=sys.stderr)
PY
}
# ---------- 命令实现 ----------
cmd_status(){
  hr "服务状态"
  for s in caddy sing-box ansgo-panel; do
    local st; st="$(systemctl is-active "$s" 2>/dev/null)"
    case "$st" in active) ok "$(printf '%-10s active' "$s")";; inactive|failed) err "$(printf '%-10s %s' "$s" "$st")";; *) warn "$(printf '%-10s %s (未安装?)' "$s" "$st")";; esac
  done
  hr "监听端口"
  ss -tlnp 2>/dev/null | awk '/LISTEN/{print $4}' | sort -u | sed 's/^/  /'
  hr "资源"
  printf "  内存: %s\n" "$(free -m | awk '/Mem:/{print $3"MB / "$2"MB"}')"
  printf "  负载: %s\n" "$(cut -d' ' -f1-3 /proc/loadavg)"
  printf "  运行: %s\n" "$(uptime -p 2>/dev/null || uptime)"
  hr "证书"
  cmd_cert_status 2>/dev/null || true
}

cmd_info(){ hr "节点信息"; echo "  域名: $(DOMAIN)"; print_uris; hr "面板"; echo "  端口: $(_conf panel_port)"; echo "  路径: $(_conf url_path)"; echo "  用户: $(_conf admin_user)"; }

cmd_restart(){
  local t="${1:-all}"
  case "$t" in
    ss|anytls|socks) restart_svc sing-box;;
    naive|caddy) restart_svc caddy;;
    panel|ansgo-panel) restart_svc ansgo-panel;;
    all) restart_svc caddy; restart_svc sing-box; restart_svc ansgo-panel;;
    *) err "未知目标: $t (可用: ss anytls socks naive panel all)"; return 1;;
  esac
}
cmd_stop(){ local t="${1:-}"; [ -z "$t" ] && { err "用法: ansgo-admin stop [ss|anytls|socks|naive|panel]"; return 1; }; stop_svc "$(svc_of "$t")"; }
cmd_logs(){ local t="${1:-all}"; case "$t" in ss|anytls|socks|sing-box) journalctl -u sing-box -n 50 --no-pager;; naive|caddy) journalctl -u caddy -n 50 --no-pager;; panel|ansgo-panel) journalctl -u ansgo-panel -n 50 --no-pager;; all) journalctl -u caddy -u sing-box -u ansgo-panel -n 30 --no-pager;; *) err "未知目标: $t";; esac; }

cmd_regen(){
  local t="${1:-}"; [ -z "$t" ] && { err "用法: ansgo-admin regen [ss|anytls|socks|naive]"; return 1; }
  do_backup >/dev/null || return 1
  case "$t" in
    ss)
      local k m; k="$(gen_ss_key)"; m="$(_secret SS_METHOD)"; [ -n "$m" ] || m=2022-blake3-aes-128-gcm; _setsecret SS_KEY "$k"; _setsecret SS_METHOD "$m"
      warn "已重置 SS 密钥，将重启 sing-box（现有连接会断开）。"
      ansgo-genconf sing-box && restart_svc sing-box && print_uris;;
    anytls)
      local p; p="$(gen_anytls_pass)"; _setsecret ANYTLS_PASS "$p"
      warn "已重置 AnyTLS 密码，将重启 sing-box。"
      ansgo-genconf sing-box && restart_svc sing-box && print_uris;;
    socks)
      local u pw; u="$(gen_socks_user)"; pw="$(gen_socks_pass)"; _setsecret SOCKS_USER "$u"; _setsecret SOCKS_PASS "$pw"
      warn "已重置 SOCKS5 账号，将重启 sing-box。"
      ansgo-genconf sing-box && restart_svc sing-box && print_uris;;
    naive)
      local u pw; u="$(gen_naive_user)"; pw="$(gen_naive_pass)"; _setsecret NAIVE_USER "$u"; _setsecret NAIVE_PASS "$pw"
      warn "已重置 NaiveProxy 账号，将重启 caddy。"
      ansgo-genconf caddy && restart_svc caddy && print_uris;;
    *) err "未知目标: $t (可用: ss anytls socks naive)"; return 1;;
  esac
}

cmd_regen2(){
  # v1.5.26: 兼容别名 -> 调 regen-landing 1（旧 ANYTLS2_* 已迁移为 LANDING_1_*）
  warn "regen2 已弃用（v1.5.26），自动转发到 regen-landing 1"
  cmd_regen_landing 1
}

# cmd_regen_landing <id>：生成/重置单个落地服务的 anytls 凭证（v1.5.26）。
#   写 LANDING_<id>_PASS + LANDING_<id>_UUID 到 secrets.env（不重启服务，由调用方决定）。
#   Go 端 api/landings/regen 调用本命令后自行 genconf+restart+verify。
cmd_regen_landing(){
  local id="${1:-}"
  [ -n "$id" ] || { err "用法: ansgo-admin regen-landing <id>"; return 1; }
  do_backup >/dev/null || return 1
  local p u
  p="$(gen_anytls_pass)"; u="$(cat /proc/sys/kernel/random/uuid)"
  _setsecret "LANDING_${id}_PASS" "$p"; _setsecret "LANDING_${id}_UUID" "$u"
  ok "已生成落地服务 #${id} 凭证（LANDING_${id}_*）"
  echo "  LANDING_${id}: user=$u pass=$p"
}

cmd_group2(){
  # v1.5.26: 旧命令保留兼容（标记 deprecated），转发为对 landings[0] 的操作。
  #   新代码请用面板「落地服务」页或直接编辑 panel.json 的 landings 数组。
  warn "group2 命令已弃用（v1.5.26），请用面板「落地服务」页管理落地服务"
  local act="${1:-status}"
  if [ "$act" = "status" ]; then
    echo "landings 配置见 $CONF 的 landings 数组"
    echo "LANDING_1_PASS=${LANDING_1_PASS:-未生成}"
    return
  fi
  err "group2 enable/disable 已弃用，请用面板「落地服务」页（支持多落地服务）"
  return 1
}
cmd_cert_status(){
  local cf="${CERTDIR}/fullchain.pem"
  [ -f "$cf" ] || { err "证书文件不存在: $cf"; return 1; }
  openssl x509 -in "$cf" -noout -subject -issuer -dates 2>/dev/null | sed 's/^/  /'
  local end; end="$(openssl x509 -in "$cf" -noout -enddate 2>/dev/null | cut -d= -f2)"
  local days; days=$(( ( $(date -d "$end" +%s 2>/dev/null || date -jf '%b %d %T %Y %z' "$end" +%s) - $(date +%s) ) / 86400 ))
  printf "  剩余天数: %s\n" "$days"
}

cmd_cert_renew(){ do_backup >/dev/null || return 1; warn "手动触发 acme.sh 续期..."; local log=/var/log/ansgo/cert-issue.log rc=0
  ansgo_log_trim "$log"
  /root/.acme.sh/acme.sh --renew -d "$(DOMAIN)" --ecc --force >>"$log" 2>&1 || rc=$?
  if [ "$rc" = 0 ]; then /usr/local/bin/ansgo-cert-reload >>"$log" 2>&1 || rc=$?; fi
  tail -15 "$log"
  return "$rc"; }

# cmd_cert_issue：用 panel.json 里保存的 Dynu 凭证触发一次完整签发（v1.5.27）。
# 对应面板「证书管理」页的「🚀 立即签发证书」。适用 manual→acme 切换后或证书丢失。
# 凭证从 panel.json 读出注入环境（与 install.sh / panel Go runCertIssue 同语义）。
cmd_cert_issue(){
  local DOMAIN EMAIL DYNU_API_KEY DYNU_CLIENT_ID DYNU_SECRET
  eval "$(python3 - "$CONF" <<'PY' 2>/dev/null
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception as e:
    sys.exit(0)
def sh(v):
    import shlex
    return shlex.quote(v or '')
print(f"DOMAIN={sh(d.get('domain',''))}")
print(f"EMAIL={sh(d.get('acme_email',''))}")
print(f"DYNU_API_KEY={sh(d.get('dynu_api_key',''))}")
print(f"DYNU_CLIENT_ID={sh(d.get('dynu_client_id',''))}")
print(f"DYNU_SECRET={sh(d.get('dynu_secret',''))}")
PY
)"
  [ -n "$DOMAIN" ] || { err "无法从 $CONF 读取 domain"; return 1; }
  [ -n "$DYNU_API_KEY" ] || [ -n "$DYNU_CLIENT_ID" ] || { err "panel.json 未配置 Dynu 凭证（dynu_api_key 或 dynu_client_id+dynu_secret）。请在面板「证书管理」页填写，或编辑 $CONF 后重试。"; return 1; }
  warn "触发 Let's Encrypt DNS-01 签发（域名=$DOMAIN），约 1-3 分钟..."
  DOMAIN="$DOMAIN" EMAIL="$EMAIL" \
    DYNU_API_KEY="$DYNU_API_KEY" DYNU_CLIENT_ID="$DYNU_CLIENT_ID" DYNU_SECRET="$DYNU_SECRET" \
    bash "$ROOT/etc/ansgo-deploy/ansgo-cert-issue.sh" >/dev/null 2>&1
  local rc=$?
  tail -25 /var/log/ansgo/cert-issue.log
  return "$rc"
}

cmd_panel_pass(){
  if [ -x "$BVPANEL" ]; then
    local pw; pw="$(gen_panel_pass)"
    "$BVPANEL" -setpass "$pw" && restart_svc ansgo-panel && ok "新面板密码（请立即保存，仅此一次显示）:" && printf "  %s\n" "$pw"
  else err "ansgo-panel 二进制不存在，无法 bcrypt 哈希。安装面板后重试。"; return 1; fi
}
cmd_panel_path(){
  local p="/$(openssl rand -hex 4)/"
  do_backup >/dev/null || return 1; _setconf url_path "$p"; restart_svc ansgo-panel
  ok "新面板 URL 路径: $p"
  echo "  完整地址: https://$(DOMAIN):$(_conf panel_port)$p"
}
cmd_panel_port(){
  local p="${1:-15608}"
  case "$p" in ''|*[!0-9]*) err "端口必须为数字"; return 1;; esac
  do_backup >/dev/null || return 1; _setconf panel_port "$p"; restart_svc ansgo-panel
  ok "面板端口已改为 $p，请用新端口访问（会话已重置需重新登录）。"
}

cmd_firewall(){
  local act="${1:-list}"
  case "$act" in
    list) nft list ruleset 2>/dev/null | sed 's/^/  /' || warn "nft 无规则或未安装（policy=accept 全放行）";;
    open) [ -z "${2:-}" ] && { err "用法: ansgo-admin firewall open PORT"; return 1; }; nft add rule inet filter input tcp dport "$2" accept 2>/dev/null || warn "无 inet filter 表，跳过（policy=accept 已放行）"; ok "放行 $2";;
    close) [ -z "${2:-}" ] && { err "用法: ansgo-admin firewall close PORT"; return 1; }; warn "按 AGENTS 约定不添加 drop 规则以免锁死 SSH；如确需关闭端口请改服务端口或停服务。";;
    *) err "用法: ansgo-admin firewall [list|open PORT|close PORT]";;
  esac
}

cmd_update(){
  local target="${1:-}"
  case "$target" in
    sing-box|caddy) /usr/local/bin/ansgo-upgrade --yes --metal;;
    panel)
      local src="${2:-}"
      [ -s "$src" ] || { err "用法: ansgo-admin update panel <新二进制路径>"; return 1; }
      do_backup >/dev/null || return 1
      (
        set -e
        stage=$(mktemp -d /usr/local/bin/.ansgo-update.XXXXXX)
        trap 'rm -rf "$stage"' EXIT
        cp "$src" "$stage/panel"
        # 同时检查 ELF 架构，拒绝非当前平台可执行文件。
        python3 - "$stage/panel" <<'PYELF'
import platform, struct, sys
h=open(sys.argv[1], 'rb').read(20)
arch={'x86_64':62, 'aarch64':183, 'arm64':183}.get(platform.machine())
assert len(h)==20 and h[:5]==b'\x7fELF\x02' and h[5]==1
assert struct.unpack('<H',h[18:20])[0]==arch, 'ELF 架构不匹配'
PYELF
        cp -p "$BVPANEL" "$stage/old"
        chmod 755 "$stage/panel"
        mv "$stage/panel" "$BVPANEL"
        if ! restart_svc ansgo-panel; then
          mv "$stage/old" "$BVPANEL"
          restart_svc ansgo-panel || true
          exit 1
        fi
      );;
    *) err "用法: ansgo-admin update [sing-box|caddy|panel <路径>]"; return 1;;
  esac
}

cmd_restore(){
  local archive="${1:-}"
  if [ -z "$archive" ]; then
    archive=$(python3 - "$BACKUP_ROOT" <<'PYLATEST'
import glob, os, sys, tarfile
for path in sorted(glob.glob(sys.argv[1]+'/*.tar.gz'),key=os.path.getmtime,reverse=True):
    try:
        with tarfile.open(path) as tar: tar.getmember('manifest.json')
    except (OSError, tarfile.TarError, KeyError): continue
    print(path)
    break
PYLATEST
)
  fi
  [ -f "$archive" ] || { err "未找到备份: $archive"; return 1; }
  local was_active="" was_enabled="" svc rc=0 rollback path_list
  local -a restore_paths=()
  path_list=$(python3 - "$archive" <<'PYMANIFEST'
import json, sys, tarfile
with tarfile.open(sys.argv[1]) as tar:
    for entry in json.load(tar.extractfile('manifest.json')):
        p=entry['path']
        if not p or p.startswith('/') or any(x in ('', '.', '..') for x in p.split('/')) or any(ord(c)<32 for c in p):
            raise ValueError('非法 manifest')
        print('/'+p)
PYMANIFEST
) || return 1
  while IFS= read -r path; do restore_paths+=("$path"); done <<< "$path_list"
  if [ -z "$ROOT" ]; then
    for svc in caddy sing-box ansgo-panel; do
      systemctl is-active --quiet "$svc" && was_active+="$svc"$'\n'
      systemctl is-enabled --quiet "$svc" && was_enabled+="$svc"$'\n'
    done
    # 先停写入者；inactive unit 正常也会返回 0，失败则不继续覆盖运行文件。
    if ! systemctl stop ansgo-panel caddy sing-box; then
      _restart_after_restore_failure "$was_active" || true
      return 1
    fi
  fi
  rollback=$(ansgo_backup restore "${restore_paths[@]}") || {
    [ -n "$ROOT" ] || _restart_after_restore_failure "$was_active" || true
    return 1
  }
  if ! ansgo_restore "$archive"; then
    [ -z "$ROOT" ] && _restart_after_restore_failure "$was_active" || true
    return 1
  fi
  if [ -z "$ROOT" ]; then
    if ! systemctl daemon-reload || ! ansgo_logs_init ||
       ! ansgo_log_trim /var/log/ansgo/genconf.log ||
       ! ansgo-genconf all >> /var/log/ansgo/genconf.log 2>&1; then
      rc=1
    fi
    # 与开机语义一致，恢复所有原启用载体；单个失败不阻止其余服务恢复，但整体返回非零。
    for svc in caddy sing-box ansgo-panel; do
      printf '%s\n' "$was_enabled" | grep -qx "$svc" || continue
      [ "$rc" = 0 ] || break
      restart_svc "$svc" || rc=1
    done
    if [ "$rc" != 0 ]; then
      err "恢复后验证失败，回滚到恢复操作前的完整快照: $rollback"
      systemctl stop ansgo-panel caddy sing-box || true
      ansgo_restore "$rollback" || err "快照回滚失败，请保留备份手动排查: $rollback"
      systemctl daemon-reload || true
      _restart_after_restore_failure "$was_active" || true
      return 1
    fi
  fi
  ok "已恢复完整备份: $archive"
  cmd_prune --yes
}

cmd_uninstall(){
  warn "将停止并移除 ansgo-panel / ansgo-admin / ansgo-genconf / ansgo-cert-reload（保留 sing-box caddy 与所有配置备份）。"
  read -r -p "确认卸载面板管理组件? 输入 yes: " a
  [ "$a" = "yes" ] || { echo "已取消"; return; }
  systemctl disable --now ansgo-autoupgrade.timer 2>/dev/null || true
  systemctl stop ansgo-panel 2>/dev/null; systemctl disable ansgo-panel 2>/dev/null
  rm -f /usr/local/bin/ansgo-panel /usr/local/bin/ansgo-admin /usr/local/bin/ansgo-genconf /usr/local/bin/ansgo-cert-reload
  rm -f /etc/systemd/system/ansgo-panel.service; systemctl daemon-reload
  ok "已卸载管理组件。配置与备份保留在 /etc/ansgo-panel/ /etc/ansgo-backup-*"
}

usage(){
  cat <<'EOF'
ansgo-admin —— ANS-GO 离线管理
  status                      多协议+面板状态 / 端口 / 资源 / 证书
  info                        节点连接参数 + URI + 面板信息
  restart [ss|anytls|socks|naive|panel|all]
  stop    [ss|anytls|socks|naive|panel]
  logs    [ss|anytls|socks|naive|panel|all]
  regen   [ss|anytls|socks|naive]   重置密钥（自动备份+重启+打印新URI）
  regen-landing <id>                 生成/重置单个落地服务凭证（v1.5.26）
  regen2                             [已弃用] 转发到 regen-landing 1
  group2 [status]                    [已弃用] 落地服务请在面板「落地服务」页管理
  cert status | renew | issue   证书到期 / 手动续期 / 用保存的 Dynu 凭证签发（v1.5.27）
  panel-pass                  重置面板密码（打印新密码）
  panel-path                  重置面板 URL 路径（兜底）
  panel-port [PORT]           重置面板端口（兜底）
  firewall [list|open PORT|close PORT]
  backup                      备份所有配置
  prune [--yes]               清理备份/过期临时文件，输出 FREED_BYTES
  upgrade [升级参数]           调用统一版本升级器
  restore [备份.tar.gz]           回滚配置
  update  [sing-box|caddy|panel [路径]]
  uninstall                   卸载面板管理组件（保留配置备份）
EOF
}

# ---------- 入口 ----------
cmd="${1:-status}"; shift || true
case "$cmd" in
  status) cmd_status;;
  info) cmd_info;;
  restart) cmd_restart "${1:-all}";;
  stop) cmd_stop "${1:-}";;
  logs) cmd_logs "${1:-all}";;
  regen) cmd_regen "${1:-}";;
  regen2) cmd_regen2;;
  regen-landing) cmd_regen_landing "${1:-}";;
  group2) cmd_group2 "${1:-}";;
  cert) case "${1:-status}" in status) cmd_cert_status;; renew) cmd_cert_renew;; issue) cmd_cert_issue;; *) err "用法: ansgo-admin cert [status|renew|issue]";; esac;;
  panel-pass) cmd_panel_pass;;
  panel-path) cmd_panel_path;;
  panel-port) cmd_panel_port "${1:-}";;
  firewall) cmd_firewall "${1:-list}" "${2:-}";;
  backup) do_backup;;
  prune) cmd_prune "${1:-}";;
  upgrade) /usr/local/bin/ansgo-upgrade "$@";;
  restore) cmd_restore "${1:-}";;
  update) cmd_update "${1:-}" "${2:-}";;
  uninstall) cmd_uninstall;;
  -h|--help|help) usage;;
  *) err "未知命令: $cmd"; usage; exit 1;;
esac

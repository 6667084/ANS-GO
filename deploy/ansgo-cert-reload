#!/bin/bash
# =============================================================================
# ansgo-cert-reload —— 证书续期/替换后按需重载三服务
#
# 设计：重载「配置文件存在」的服务（不再 grep 固定证书路径）。
#   - acme.sh 模式：由 acme.sh --install-cert 的 --reloadcmd 自动调用
#   - 手动证书模式：由面板「重新加载证书」按钮或 SSH 手动调用
#   - 两种模式下证书都确已变更，文件存在即可 reload，无需校验路径内容
#
# 注：caddy 因 Caddyfile 设了 admin off，reload 无法通信，直接 restart
#     （续期闪断 1-2s 可接受）；sing-box 同样用 restart。
# =============================================================================
set -uo pipefail
rc=0
for svc in caddy sing-box; do
  # 面板事务先校验证书与生成配置，随后自行重启代理服务。
  [ "${ANSGO_SKIP_PROXY_RESTART:-0}" != 1 ] || continue
  case "$svc" in caddy) config=/etc/caddy/Caddyfile;; *) config=/etc/sing-box/config.json;; esac
  if [ -f "$config" ] && systemctl is-active --quiet "$svc"; then
    systemctl reset-failed "$svc" 2>/dev/null || true
    if ! systemctl restart "$svc" || ! systemctl is-active --quiet "$svc"; then
      printf '证书重载失败: %s\n' "$svc" >&2
      rc=1
    fi
  fi
done
[ "$rc" = 0 ] || exit "$rc"
# 面板可自行安排重启；cron 调用时交给独立任务，避免中断当前签发进程。
if [ "${ANSGO_SKIP_PANEL_RESTART:-0}" != 1 ] && systemctl is-active --quiet ansgo-panel; then
  command -v systemd-run >/dev/null || { echo '缺少 systemd-run，无法安全重启面板' >&2; exit 1; }
  # acme.sh reloadcmd 可能在签发子进程中执行；用独立 transient unit 延迟重启，避免自杀。
  systemd-run --quiet --collect --unit="ansgo-cert-panel-reload-$(date +%s)-$$" --on-active=3s \
    /bin/sh -c '/bin/systemctl reset-failed ansgo-panel 2>/dev/null; exec /bin/systemctl restart ansgo-panel' || exit 1
fi
exit 0

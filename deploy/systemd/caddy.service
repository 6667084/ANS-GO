[Unit]
Description=Caddy (naive forwardproxy + 域名伪装反代)
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
# 注：Caddyfile 设 admin off，reload 不可用，改配置用 restart
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# v1.5.17: 加 CAP_DAC_READ_SEARCH（同 sing-box.service，读 manual 证书目录所需）
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_READ_SEARCH
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
